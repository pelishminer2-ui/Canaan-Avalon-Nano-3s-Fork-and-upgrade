# Configuration file for ifup(8) and ifdown(8).

auto lo
iface lo inet loopback

# USB Ethernet: ASIX/RTL/SMSC typically land on eth0; CDC-ECM/NCM/EEM and
# RNDIS land on usb0. mm_miner also hotplugs DHCP on both; ifup brings the
# link up at boot if the adapter is already present.
allow-hotplug eth0
iface eth0 inet manual
    up ip link set $IFACE up || true
    up udhcpc -b -t 1 -T 1 -A 2 -s /etc/network/udhcpc-metric.script -p /var/run/udhcpc.$IFACE.pid -i $IFACE || true

allow-hotplug usb0
iface usb0 inet manual
    up ip link set $IFACE up || true
    up udhcpc -b -t 1 -T 1 -A 2 -s /etc/network/udhcpc-metric.script -p /var/run/udhcpc.$IFACE.pid -i $IFACE || true
